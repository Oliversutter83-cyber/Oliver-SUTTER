# URL publique de l'application (sans slash final)
APP_URL=http://localhost:3000

# --- Stripe (paiements) ---
# Dashboard Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=
# Dashboard Stripe → Développeurs → Webhooks → endpoint {APP_URL}/api/stripe/webhook
# Événements à cocher : checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Dashboard Stripe → Catalogue → créer 2 tarifs récurrents mensuels (29 € et 149 €)
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCE=
# Sans ces 4 variables : mode démonstration (parcours d'achat simulé, testable en local).

# --- Resend (emails transactionnels : accès client, alertes) ---
# resend.com → API Keys. Sans clé : les liens de connexion s'affichent à l'écran (mode démo).
RESEND_API_KEY=
EMAIL_FROM="AccessiScan <contact@accessiscan.fr>"

# --- Surveillance mensuelle ---
# Secret partagé du cron : générer avec `openssl rand -hex 24`
CRON_SECRET=

# Dev uniquement : autorise le scan d'hôtes locaux pour les tests (ne JAMAIS activer en production)
# ALLOW_LOCAL_SCAN=1
